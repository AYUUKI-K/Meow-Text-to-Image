+// Native nested-image storage ABI used by third-party extensions.
+use super::*;
+
+fn folder_path(raw: &str) -> Result<PathBuf, DomainError> {
+    let parts: Vec<_> = raw.split('/').collect();
+    if raw.len() > 1024 || parts.is_empty() || parts.len() > 3 || parts.iter().any(|part| {
+        let upper = part.to_ascii_uppercase();
+        part.is_empty() || part.trim() != *part || part.chars().count() > 64
+            || !part.chars().all(|c| c.is_alphanumeric() || matches!(c, '_' | '-' | ' '))
+            || matches!(upper.as_str(), "CON" | "PRN" | "AUX" | "NUL")
+            || ((upper.starts_with("COM") || upper.starts_with("LPT"))
+                && upper.len() == 4 && matches!(upper.as_bytes()[3], b'1'..=b'9'))
+    }) {
+        return Err(DomainError::InvalidData("Invalid archive folder".into()));
+    }
+    Ok(parts.iter().collect())
+}
+fn owned_image(name: &str) -> bool {
+    let Some(stem) = name.strip_suffix(".png") else { return false; };
+    let Some((prefix, rest)) = stem.split_once('-') else { return false; };
+    if !matches!(prefix, "miao" | "sample" | "test") || rest.len() < 13 { return false; }
+    let bytes = rest.as_bytes();
+    bytes[..13].iter().all(u8::is_ascii_digit)
+        && (bytes.len() == 13 || (bytes[13] == b'-' && bytes.len() > 14
+            && bytes[14..].iter().all(|b| b.is_ascii_hexdigit() || *b == b'-')))
+}
+impl UserMediaService {
+    pub async fn upload_user_archive_image(&self, image_base64: String, folder: String, filename: String) -> Result<UserImageUploadResult, DomainError> {
+        let relative = folder_path(&folder)?;
+        if !owned_image(&filename) || image_base64.len() > 32 * 1024 * 1024 {
+            return Err(DomainError::InvalidData("Invalid archive image".into()));
+        }
+        let bytes = BASE64_STANDARD.decode(image_base64.trim().as_bytes())
+            .map_err(|_| DomainError::InvalidData("Invalid PNG base64".into()))?;
+        if !bytes.starts_with(&[137, 80, 78, 71, 13, 10, 26, 10]) {
+            return Err(DomainError::InvalidData("PNG required".into()));
+        }
+        self.store.ensure_archive_folder(&relative).await.map_err(DomainError::from)?;
+        self.store.write_archive_file(&relative.join(&filename), bytes).await.map_err(DomainError::from)?;
+        Ok(UserImageUploadResult { path: format!("user/images/{}/{}", to_url_path(&relative), filename) })
+    }
+    pub async fn list_user_archive_images(&self, folder: String) -> Result<Vec<String>, DomainError> {
+        let relative = folder_path(&folder)?;
+        self.store.ensure_archive_folder(&relative).await.map_err(DomainError::from)?;
+        let files = self.store.list_files(&relative).await.map_err(DomainError::from)?;
+        Ok(files.into_iter().filter(|entry| owned_image(&entry.name)).map(|entry| entry.name).collect())
+    }
+    pub async fn list_user_archive_folders(&self, root: String) -> Result<Vec<String>, DomainError> {
+        let relative = folder_path(&root)?;
+        if relative.components().count() != 1 { return Err(DomainError::InvalidData("One archive root required".into())); }
+        self.store.ensure_archive_folder(&relative).await.map_err(DomainError::from)?;
+        let folders = self.store.list_nested_folders(&relative).await.map_err(DomainError::from)?;
+        Ok(folders.into_iter().filter(|folder| folder_path(folder).is_ok() && (folder == &root || folder.starts_with(&(root.clone() + "/")))).collect())
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn rejects_traversal_and_unowned_files() {
+        for raw in ["../outside", "/absolute", "root//chat", "root\\outside", "root/a/b/c", "CON"] { assert!(folder_path(raw).is_err()); }
+        assert!(folder_path("miao-nai/猫猫--abc/Chat--123").is_ok());
+        assert!(owned_image("sample-1792737847709-abcdef.png"));
+        for raw in ["../user.png", "user.png", "miao-abc.png", "miao-1792737847709-../bad.png"] { assert!(!owned_image(raw)); }
+    }
+}
