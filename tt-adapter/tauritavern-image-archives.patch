 #[async_trait]
 impl UserMediaStore for FilesystemUserMediaStore {
+    async fn ensure_archive_folder(&self, relative: &Path) -> Result<(), UserMediaStoreError> {
+        fs::create_dir_all(&self.user_images_dir).await.map_err(|e| UserMediaStoreError::internal(e.to_string()))?;
+        let mut current = self.user_images_dir.clone();
+        for component in relative.components() {
+            let std::path::Component::Normal(part) = component else { return Err(UserMediaStoreError::internal("Invalid archive path")); };
+            current.push(part);
+            if let Err(error) = fs::create_dir(&current).await {
+                if error.kind() != std::io::ErrorKind::AlreadyExists { return Err(UserMediaStoreError::internal(error.to_string())); }
+            }
+            let metadata = fs::symlink_metadata(&current).await.map_err(|e| UserMediaStoreError::internal(e.to_string()))?;
+            if metadata.file_type().is_symlink() || !metadata.is_dir() { return Err(UserMediaStoreError::internal("Archive symlinks are not allowed")); }
+        }
+        Ok(())
+    }
+    async fn write_archive_file(&self, relative: &Path, bytes: Vec<u8>) -> Result<(), UserMediaStoreError> {
+        let parent = relative.parent().ok_or_else(|| UserMediaStoreError::internal("Invalid archive path"))?;
+        self.ensure_archive_folder(parent).await?;
+        let mut file = fs::OpenOptions::new().write(true).create_new(true).open(self.resolve(relative)).await
+            .map_err(|e| UserMediaStoreError::internal(e.to_string()))?;
+        file.write_all(&bytes).await.map_err(|e| UserMediaStoreError::internal(e.to_string()))
+    }
+    async fn list_nested_folders(&self, relative: &Path) -> Result<Vec<String>, UserMediaStoreError> {
+        self.ensure_archive_folder(relative).await?;
+        let mut folders = Vec::new();
+        let mut pending = vec![relative.to_path_buf()];
+        while let Some(folder) = pending.pop() {
+            folders.push(folder.components().map(|c| c.as_os_str().to_string_lossy()).collect::<Vec<_>>().join("/"));
+            if folders.len() > 5000 { return Err(UserMediaStoreError::internal("Too many archive folders")); }
+            if folder.components().count() >= 3 { continue; }
+            let mut entries = fs::read_dir(self.resolve(&folder)).await.map_err(|e| UserMediaStoreError::internal(e.to_string()))?;
+            while let Some(entry) = entries.next_entry().await.map_err(|e| UserMediaStoreError::internal(e.to_string()))? {
+                let kind = entry.file_type().await.map_err(|e| UserMediaStoreError::internal(e.to_string()))?;
+                if kind.is_dir() && !kind.is_symlink() { pending.push(folder.join(entry.file_name())); }
+            }
+        }
+        folders.sort(); Ok(folders)
+    }
+
